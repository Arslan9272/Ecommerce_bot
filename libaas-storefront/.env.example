# Backend (FastAPI) base URL — storefront grid + Saathi bot read from it.
VITE_API_BASE=http://localhost:8000

# Which voice provider the widget uses.
#   browser = free SpeechSynthesis (dev/demo only, weak Urdu)
#   cloud   = POST text to the TTS proxy below, play returned audio (production)
VITE_TTS_PROVIDER=browser

# The widget calls THIS endpoint for cloud voice. The API key NEVER lives in the frontend.
VITE_TTS_ENDPOINT=/api/tts

# Server-side only (used by server/tts-proxy.example.ts) — keep secret, never expose to the browser:
# TTS_VENDOR=elevenlabs        # or: azure
# ELEVENLABS_API_KEY=...
# ELEVENLABS_VOICE_ID=...       # pick an Urdu-capable / multilingual voice
